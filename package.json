  "main": "dist/index.js",
  "exports": "./dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^14.13.1 || >=16.0.0"
  },
  "bin": {
    "notion2content": "dist/main.js"
  },
  "scripts": {
    "start": "npm run build && node dist/main.js",
    "start:ts": "node --experimental-strip-types src/main.ts",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --experimental-test-module-mocks --experimental-strip-types --test",
    "test:coverage": "npm run test -- --experimental-test-coverage",
    "lint:types": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist/*"
  },
  "dependencies": {
    "@notionhq/client": "^5.24.0",
    "chanpuru": "^0.2.2",
    "gray-matter": "^4.0.3",
    "hast-util-to-mdast": "^10.1.0",
    "mdast-util-gfm": "^3.0.0",
    "mdast-util-to-markdown": "^2.1.0",
    "notion2hast": "^0.2.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/yargs": "^17.0.32",
    "typescript": "^7.0.2"
  }
